<?xml version="1.0" encoding="utf-8"?>
<!--
  The system launch screen (Android 12+) always draws an icon, and it can't draw text. The app's own
  splash shows the logo with the name, so the system one gets this empty icon: the first thing you see
  is grey, then the logo and the name together, never the logo alone.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#00000000" />
    <size android:width="1dp" android:height="1dp" />
</shape>
